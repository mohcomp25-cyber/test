# Copy this file to .env and fill in YOUR OWN Foodics credentials.
# .env is git-ignored — never commit real credentials.

FOODICS_EMAIL=you@example.com
FOODICS_PASSWORD=your-password

# Optional: run with a visible browser window (1) or headless (0, default)
HEADLESS=1

# Optional: base URL (change only if you use a regional/staging console)
FOODICS_BASE_URL=https://console.foodics.com

# Optional: where downloaded report files are saved
DOWNLOAD_DIR=./downloads

# Optional: politeness delay (seconds) between page actions to avoid hammering
RATE_LIMIT_SECONDS=1.5
