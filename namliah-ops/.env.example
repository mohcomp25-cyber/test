# منصة عمليات نملية — انسخ هذا الملف إلى .env واملأ القيم
# cp .env.example .env

# منفذ الخادم
PORT=3000

# سر الجلسات — ولّد قيمة عشوائية: openssl rand -hex 32
SESSION_SECRET=

# المفتاح السري لاستقبال بيانات المبيعات من الوورك فلو (n8n/Make)
# يجب أن يرسله الوورك فلو في هيدر X-Webhook-Secret
WEBHOOK_SECRET=

# تكامل مراجعات قوقل ماب عبر Apify
APIFY_TOKEN=
# رابط صفحة الفرع في قوقل ماب (انسخه من زر المشاركة في Google Maps)
GOOGLE_MAPS_URL=
# (اختياري) الـ actor المستخدم — الافتراضي:
APIFY_ACTOR=compass~google-maps-reviews-scraper
# (اختياري) أقصى عدد مراجعات تُسحب في كل مزامنة
APIFY_MAX_REVIEWS=200
# (اختياري) جدولة المزامنة اليومية (cron) — الافتراضي 3:30 فجراً بتوقيت الرياض
REVIEWS_CRON=30 3 * * *

# مسار قاعدة البيانات (اختياري)
DB_PATH=./data/namliah.db

# فعّل كوكيز HTTPS فقط خلف بروكسي مؤمّن (ضعها 1 في الإنتاج)
COOKIE_SECURE=0
