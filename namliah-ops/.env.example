# منصة عمليات نملية — انسخ هذا الملف إلى .env واملأ القيم
# cp .env.example .env

# منفذ الخادم
PORT=3000

# سر الجلسات — ولّد قيمة عشوائية: openssl rand -hex 32
SESSION_SECRET=

# ===== الفروع =====
# مفتاح سري لكل فرع — الوورك فلو يرسل مفتاح فرعه في هيدر X-Webhook-Secret
# والمنصة تعرف الفرع من المفتاح المطابق. المفعّل حالياً: جدة.
WEBHOOK_SECRET_JEDDAH=
WEBHOOK_SECRET_ABHA=
WEBHOOK_SECRET_MAKKAH=

# ===== مراجعات قوقل ماب عبر Apify =====
APIFY_TOKEN=
# رابط صفحة كل فرع في قوقل ماب (زر المشاركة في Google Maps)
GOOGLE_MAPS_URL_JEDDAH=
GOOGLE_MAPS_URL_ABHA=
GOOGLE_MAPS_URL_MAKKAH=
# (اختياري) الـ actor المستخدم — الافتراضي:
APIFY_ACTOR=compass~google-maps-reviews-scraper
# (اختياري) أقصى عدد مراجعات تُسحب في كل مزامنة — الافتراضي 50
# المزامنة تسحب مراجعات يوم العمل فقط (من أمس بتوقيت الرياض) توفيراً للتوكن
APIFY_MAX_REVIEWS=50
# (اختياري) جدولة المزامنة اليومية (cron) — الافتراضي ١٢ ليلاً بتوقيت الرياض
REVIEWS_CRON=0 0 * * *

# مسار قاعدة البيانات (اختياري)
DB_PATH=./data/namliah.db

# فعّل كوكيز HTTPS فقط خلف بروكسي مؤمّن (ضعها 1 في الإنتاج)
COOKIE_SECURE=0
